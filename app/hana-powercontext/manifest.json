{
  "manifestVersion": 2,
  "id": "hana-powercontext",
  "name": "PowerContext",
  "version": "0.3.2",
  "description": "Bounded recall and durable handoff for this session, backed by a running PowerContext Server.",
  "entry": "index.js",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/hooks.agent-pre-step",
    "app/hooks.agent-before-start"
  ],
  "icon": "assets/icon.svg",
  "minAppVersion": "1.0.0-beta",
  "network": {
    "allowedHosts": [
      "127.0.0.1"
    ],
    "allowLocalhost": true,
    "methods": [
      "GET",
      "POST"
    ],
    "defaultTimeoutMs": 5000,
    "maxResponseBytes": 131072
  },
  "contributes": {
    "cards": [
      {
        "id": "dashboard",
        "title": "PowerContext 看板",
        "description": "当前 Scope、最新 Handoff 状态、记忆清单与 Server 连通状态。",
        "route": "/dashboard.html",
        "face": {
          "image": "assets/dashboard-cover.svg"
        }
      }
    ]
  }
}
